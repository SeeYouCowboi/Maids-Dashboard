# Maids Dashboard — Environment Variables Reference
# Copy to .env.development or .env.production and set values.

# --- Required ---------------------------------------------------------------

# Base URL for the MaidsClaw gateway
# Development default: http://localhost:18790
# Production: set to your deployed MaidsClaw URL
VITE_API_BASE=http://localhost:18790

# --- Build-Time (set automatically) -----------------------------------------

# MaidsClaw git SHA — set by scripts/bump-maidsclaw.sh, read by vite.config.ts
# Do not set manually; run: bun run bump:maidsclaw
# MAIDSCLAW_SHA=abc123...

# --- Notes ------------------------------------------------------------------
# Authentication uses bearer tokens stored in localStorage (mc:token).
# No server-side secrets are required for the Dashboard itself.
# MaidsClaw gateway authentication and CORS are configured in MaidsClaw.
